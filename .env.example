# Copy to .env before `npm run build`/`npm run dev` to opt in — every var
# here is optional, and the widget behaves exactly as it does today (only
# trace.ts's console logging) when none of them are set. See
# src/agent/langfuseTelemetry.ts's file comment before setting these for real:
# because this repo is a static SPA with no backend, VITE_-prefixed values
# get baked into the built JS in plain text and shipped to every browser
# that loads the widget — including LANGFUSE_SECRET_KEY below. Only point
# this at a project/instance you're fine with that trade-off for.

# Required (both) to turn Langfuse tracing on at all — leaving either unset
# keeps it off.
VITE_LANGFUSE_PUBLIC_KEY=
VITE_LANGFUSE_SECRET_KEY=

# Optional — defaults to Langfuse Cloud (https://cloud.langfuse.com). Point
# this at a self-hosted instance instead if you'd rather not ship a
# Cloud-project secret key to every widget viewer.
VITE_LANGFUSE_HOST=
